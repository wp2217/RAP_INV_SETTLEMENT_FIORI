{
  "_version": "1.86.0",
  "sap.app": {
    "id": "com.roc.invsettlement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "298a2e4a-214c-4f63-8912-6b1231884435"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_roc_inv_manage_v4_v1/srvd/sap/zs_roc_inv_manage/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.roc.invsettlement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZC_ROC_INV_SET_HList",
          "target": "ZC_ROC_INV_SET_HList"
        },
        {
          "pattern": "ZC_ROC_INV_SET_H({key}):?query:",
          "name": "ZC_ROC_INV_SET_HObjectPage",
          "target": "ZC_ROC_INV_SET_HObjectPage"
        },
        {
          "pattern": "ZC_ROC_INV_SET_H({key})/_invItem({key2}):?query:",
          "name": "ZC_ROC_INV_SET_IObjectPage",
          "target": "ZC_ROC_INV_SET_IObjectPage"
        }
      ],
      "targets": {
        "ZC_ROC_INV_SET_HList": {
          "type": "Component",
          "id": "ZC_ROC_INV_SET_HList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_ROC_INV_SET_H",
              "variantManagement": "Page",
              "navigation": {
                "ZC_ROC_INV_SET_H": {
                  "detail": {
                    "route": "ZC_ROC_INV_SET_HObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "ZC_ROC_INV_SET_HObjectPage": {
          "type": "Component",
          "id": "ZC_ROC_INV_SET_HObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_ROC_INV_SET_H",
              "navigation": {
                "_invItem": {
                  "detail": {
                    "route": "ZC_ROC_INV_SET_IObjectPage"
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "ZGETPOGR": {
                      "press": "com.roc.invsettlement.ext.controller.ZPOGETGR.triggerGetPOGR",
                      "visible": "com.roc.invsettlement.ext.controller.ZPOGETGR.enabledGetPOGR",
                      "enabled": true,
                      "text": "ZGETPOGR"
                    }
                  }
                }
              }
            }
          }
        },
        "ZC_ROC_INV_SET_IObjectPage": {
          "type": "Component",
          "id": "ZC_ROC_INV_SET_IObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_ROC_INV_SET_H/_invItem"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
